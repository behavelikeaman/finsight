tsconfig.tsbuildinfo

# 환경변수 — 템플릿만 커밋한다.
# execute.py가 매 step에서 `git add -A`를 실행하므로 이 규칙이 없으면
# 자동 실행 중에 실제 키가 그대로 커밋된다.
.env*
!.env.example

# 하네스 실행 로그.
# execute.py가 매 step에서 `git add -A`를 하므로 무시하지 않으면 로그가 커밋된다.
harness.log
harness.err

# 개발 서버 로그. `npm run dev > dev.log`로 남긴 것이라 커밋할 이유가 없다.
dev.log

# Playwright MCP 작업 디렉터리. 스냅샷·스크린샷·업로드용 임시 파일이 쌓인다.
.playwright-mcp/

# 하네스 스크립트(pytest) 실행 부산물
__pycache__/
.pytest_cache/

# phase execution outputs
phases/**/phase*-output.json
phases/**/step*-output.json
.vercel
