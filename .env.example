# FinSight 환경변수 템플릿
#
# 사용법:  cp .env.example .env.local  후 값을 채운다.
# .env.local 은 절대 커밋하지 않는다.
#
# 규칙: 이 값들은 모듈 로드 시점이 아니라 **호출 시점**에 읽는다 (src/lib/env.ts).
#       로드 시점에 읽으면 키가 없는 환경에서 빌드가 깨진다.

# ─────────────────────────────────────────────────────────────
# Supabase — Auth + Postgres + RLS
# ─────────────────────────────────────────────────────────────
# 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. RLS를 우회하므로 클라이언트에 절대 노출 금지.
# 사용처는 Polar 웹훅의 tier 갱신 한 곳뿐이다.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Anthropic — 거래 분류 + Q&A (모델: claude-opus-5)
# ─────────────────────────────────────────────────────────────
# 서버 전용. 익명 세션에서는 표본 20건 분류까지만 호출한다.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Polar — 구독 결제 (Merchant of Record)
# ─────────────────────────────────────────────────────────────
# 서버 전용
POLAR_ACCESS_TOKEN=
# 웹훅 서명 검증용. 없으면 위조 요청을 걸러낼 수 없다.
POLAR_WEBHOOK_SECRET=
# Pro 플랜 상품 ID
POLAR_PRO_PRODUCT_ID=
# 개발 중에는 sandbox, 운영은 production
POLAR_SERVER=sandbox

# ─────────────────────────────────────────────────────────────
# 앱
# ─────────────────────────────────────────────────────────────
# OAuth 리다이렉트와 Polar 체크아웃 복귀에 쓴다.
# 로컬: http://localhost:3000 / 운영: https://<도메인>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Supabase 대시보드 설정 (환경변수 아님 — 수동 활성화 필요)
# ─────────────────────────────────────────────────────────────
# 아래 둘을 켜지 않으면 익명 업로드 → 계정 연결 플로우가 통째로 동작하지 않는다.
#   1. Authentication > Sign In / Up > Anonymous Sign-Ins  활성화
#   2. Authentication > Sign In / Up > Manual Linking      활성화
#   3. Authentication > Sign In / Up > Google              OAuth 클라이언트 등록
